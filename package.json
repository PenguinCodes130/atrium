{
  "name": "atrium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3102",
    "build": "next build",
    "start": "next start -p 3102",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "atrium:reset-owner": "tsx --conditions=react-server src/features/auth/cli/reset-owner.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.10",
    "@node-rs/argon2": "2.2.2",
    "@paper-design/shaders-react": "0.0.81",
    "@tanstack/react-query": "5.104.4",
    "better-auth": "1.7.10",
    "better-sqlite3": "13.0.3",
    "d3": "7.9.0",
    "drizzle-orm": "0.45.4",
    "js-yaml": "4.3.2",
    "motion": "14.3.0",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "undici": "8.12.2",
    "uplot": "1.6.31",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
