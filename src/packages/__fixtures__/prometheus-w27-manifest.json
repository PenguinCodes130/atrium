{
 "atriumApi": "1",
 "kind": "code",
 "id": "prometheus",
 "name": "Prometheus",
 "version": "1.1.0",
 "author": "Atrium",
 "homepage": "https://prometheus.io",
 "description": "Your machines' CPU, memory, disks and network, containers, Proxmox, disk health and alerts from Prometheus, plus any metric or your own PromQL.",
 "icon": "icon.svg",
 "permissions": [
  {
   "kind": "network",
   "hosts": "configured"
  },
  {
   "kind": "secret",
   "key": "password"
  },
  {
   "kind": "secret",
   "key": "token"
  }
 ],
 "config": {
  "type": "object",
  "required": [
   "baseUrl"
  ],
  "properties": {
   "baseUrl": {
    "type": "string",
    "title": "Prometheus URL",
    "description": "The address you open Prometheus at, for example http://10.0.0.7:9090.",
    "format": "uri"
   },
   "authMode": {
    "type": "string",
    "title": "Login",
    "description": "Most Prometheus servers on a LAN need no login. Pick one only if yours sits behind Basic auth or a bearer token.",
    "enum": [
     "none",
     "basic",
     "bearer"
    ],
    "x-atrium-labels": {
     "none": "No login",
     "basic": "Username and password (Basic auth)",
     "bearer": "Bearer token"
    },
    "default": "none",
    "x-atrium-secrets": {
     "none": [],
     "basic": [
      "password"
     ],
     "bearer": [
      "token"
     ]
    }
   },
   "username": {
    "type": "string",
    "title": "Username",
    "description": "The Basic auth username in front of Prometheus.",
    "x-atrium-show-when": {
     "authMode": "basic"
    }
   },
   "verifyTls": {
    "type": "boolean",
    "title": "Verify TLS",
    "description": "Turn off only for a self-signed certificate on your LAN.",
    "default": true
   }
  }
 },
 "secrets": [
  {
   "key": "password",
   "label": "Password",
   "hint": "The Basic auth password for the username above, from your reverse proxy or Prometheus web config (basic_auth_users).",
   "auth": {
    "as": "basic",
    "userKey": "username"
   }
  },
  {
   "key": "token",
   "label": "Bearer token",
   "hint": "The token your proxy or Prometheus expects in an Authorization: Bearer header. Atrium sends it only to this Prometheus address.",
   "auth": {
    "as": "bearer"
   }
  }
 ],
 "endpoints": [
  {
   "id": "machine-cpu",
   "label": "CPU in use",
   "description": "How busy one machine's processors are, in percent.",
   "shape": "stat",
   "defaultRefreshSec": 30,
   "minRefreshSec": 15,
   "group": "Machines",
   "params": {
    "type": "object",
    "properties": {
     "machine": {
      "type": "string",
      "title": "Machine",
      "description": "Pick one of your machines, or every machine.",
      "x-atrium-choices": {
       "endpointId": "machines",
       "value": "instance",
       "label": "name",
       "detail": "detail",
       "every": true
      }
     }
    },
    "required": [
     "machine"
    ]
   },
   "needs": "node-exporter on your machines"
  },
  {
   "id": "machine-memory",
   "label": "Memory in use",
   "description": "How much of one machine's memory is in use, in percent.",
   "shape": "stat",
   "defaultRefreshSec": 30,
   "minRefreshSec": 15,
   "group": "Machines",
   "params": {
    "type": "object",
    "properties": {
     "machine": {
      "type": "string",
      "title": "Machine",
      "description": "Pick one of your machines, or every machine.",
      "x-atrium-choices": {
       "endpointId": "machines",
       "value": "instance",
       "label": "name",
       "detail": "detail",
       "every": true
      }
     }
    },
    "required": [
     "machine"
    ]
   },
   "needs": "node-exporter on your machines"
  },
  {
   "id": "machine-memory-bytes",
   "label": "Memory used",
   "description": "How much memory one machine uses, in GB.",
   "shape": "stat",
   "defaultRefreshSec": 30,
   "minRefreshSec": 15,
   "group": "Machines",
   "params": {
    "type": "object",
    "properties": {
     "machine": {
      "type": "string",
      "title": "Machine",
      "description": "Pick one of your machines, or every machine.",
      "x-atrium-choices": {
       "endpointId": "machines",
       "value": "instance",
       "label": "name",
       "detail": "detail",
       "every": true
      }
     }
    },
    "required": [
     "machine"
    ]
   },
   "needs": "node-exporter on your machines"
  },
  {
   "id": "machine-disk",
   "label": "Disk in use",
   "description": "How full one disk of a machine is, in percent.",
   "shape": "stat",
   "defaultRefreshSec": 30,
   "minRefreshSec": 15,
   "group": "Machines",
   "params": {
    "type": "object",
    "properties": {
     "machine": {
      "type": "string",
