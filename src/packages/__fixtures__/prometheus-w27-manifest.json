      "description": "Which mounted disk. Most machines have one, mounted at /.",
      "default": "/",
      "x-atrium-choices": {
       "endpointId": "mounts",
       "value": "mount",
       "label": "mount",
       "detail": "detail",
       "params": {
        "machine": "machine"
       }
      }
     }
    },
    "required": [
     "machine"
    ]
   },
   "needs": "node-exporter on your machines"
  },
