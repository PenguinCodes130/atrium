 {
  "id": "machines-overview",
  "label": "Machines overview",
  "description": "One row per machine with CPU, memory, disk, network in and out, load, uptime and temperature. Good for a card for each machine.",
  "group": "All machines",
  "needs": {
   "anyMetric": [
    "node_uname_info"
   ],
   "text": "node-exporter on your machines"
  },
  "refresh": [
   30,
   30
  ],
  "kind": "table",
  "rows": "last_over_time(node_uname_info[1d])",
  "key": [
   "instance"
  ],
  "columns": [
   {
    "key": "name",
    "label": "Name",
    "value": "{machine}",
    "main": true
   },
   {
    "key": "instance",
    "label": "Address",
    "value": "{label:instance}"
   },
   {
    "key": "up",
    "label": "Up",
    "type": "status",
    "value": {
     "query": "up{ {{machine}} }"
    },
    "map": {
     "1": "up",
     "0": "down",
     "": "unknown"
    },
    "main": true
   },
   {
    "key": "cpu",
    "label": "CPU",
    "format": "percent",
    "value": {
     "query": "{{measure:cpu}}"
    },
    "main": true
   },
   {
    "key": "memory",
    "label": "Memory",
    "format": "percent",
    "value": {
     "query": "{{measure:memory}}"
    },
    "main": true
   },
   {
    "key": "disk",
    "label": "Disk (/)",
    "format": "percent",
    "value": {
     "query": "{{measure:disk}}"
    },
    "main": true
   },
   {
    "key": "netIn",
    "label": "Network in",
    "format": "bytesPerSec",
    "value": {
     "query": "{{measure:netIn}}"
    },
    "main": true
   },
   {
    "key": "netOut",
    "label": "Network out",
    "format": "bytesPerSec",
    "value": {
     "query": "{{measure:netOut}}"
    },
    "main": true
   },
   {
    "key": "load",
    "label": "Load (5 min)",
    "format": "number",
    "value": {
     "query": "{{measure:load5}}"
    }
   },
   {
    "key": "uptime",
    "label": "Uptime",
    "format": "seconds",
    "value": {
     "query": "{{measure:uptime}}"
    },
    "main": true
   },
   {
    "key": "temperature",
    "label": "Temperature",
    "format": "celsius",
    "value": {
     "query": "{{measure:temperature}}"
    }
   },
   {
    "key": "updates",
    "label": "Pending updates",
    "format": "number",
    "value": {
     "query": "{{measure:updates}}"
    }
   },
   {
    "key": "reboot",
    "label": "Reboot needed",
    "value": {
     "query": "{{measure:reboot}}"
    },
    "map": {
     "1": "Yes",
     "0": "No",
     "": ""
    }
   }
  ],
  "sort": {
   "by": "name"
  }
 },
