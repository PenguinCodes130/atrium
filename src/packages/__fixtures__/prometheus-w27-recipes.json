 {
  "id": "machine-network",
  "label": "Network traffic",
  "description": "Bytes per second one machine sends or receives on its network cards.",
  "group": "Machines",
  "needs": {
   "anyMetric": [
    "node_uname_info"
   ],
   "text": "node-exporter on your machines"
  },
  "refresh": [
   30,
   15
  ],
  "params": {
   "type": "object",
   "properties": {
    "machine": {
     "type": "string",
     "title": "Machine",
     "description": "Pick one of your machines, or every machine.",
     "x-atrium-choices": {
      "endpointId": "machines",
      "value": "instance",
      "label": "name",
      "detail": "detail",
      "every": true
     }
    },
    "direction": {
     "type": "string",
     "title": "Direction",
     "enum": [
      "in",
      "out"
     ],
     "x-atrium-labels": {
      "in": "Coming in",
      "out": "Going out"
     },
     "default": "in"
    }
   },
   "required": [
    "machine"
   ]
  },
  "measure": {
   "param": "direction",
   "map": {
    "in": "netIn",
    "out": "netOut"
   }
  },
  "kind": "stat",
  "query": "{{measure}}",
  "format": "measure",
  "statLabel": "{measure}",
  "every": {
   "param": "machine",
   "key": "instance",
   "name": "{machine}"
  }
 },
 {
  "id": "machine-load",
  "label": "Load average",
  "description": "How many tasks wait for the processors, on average.",
  "group": "Machines",
  "needs": {
   "anyMetric": [
    "node_uname_info"
   ],
   "text": "node-exporter on your machines"
  },
  "refresh": [
   30,
   15
  ],
  "params": {
   "type": "object",
   "properties": {
    "machine": {
     "type": "string",
     "title": "Machine",
     "description": "Pick one of your machines, or every machine.",
     "x-atrium-choices": {
      "endpointId": "machines",
      "value": "instance",
      "label": "name",
      "detail": "detail",
      "every": true
     }
    },
    "period": {
     "type": "string",
     "title": "Over",
     "enum": [
      "1",
      "5",
      "15"
     ],
     "x-atrium-labels": {
      "1": "1 minute",
      "5": "5 minutes",
      "15": "15 minutes"
     },
