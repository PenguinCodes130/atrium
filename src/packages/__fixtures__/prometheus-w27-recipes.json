 {
  "id": "machine-up",
  "label": "Up or down",
  "description": "Whether Prometheus can reach one machine right now.",
  "group": "Machines",
  "needs": {
   "anyMetric": [
    "node_uname_info"
   ],
   "text": "node-exporter on your machines"
  },
  "refresh": [
   30,
   10
  ],
  "params": {
   "type": "object",
   "properties": {
    "machine": {
     "type": "string",
     "title": "Machine",
     "description": "Pick one of your machines, or every machine.",
     "x-atrium-choices": {
      "endpointId": "machines",
      "value": "instance",
