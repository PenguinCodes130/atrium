  },
  "refresh": [
   30,
   15
  ],
  "kind": "table",
  "rows": "pve_guest_info{template!=\"1\"}",
  "key": [
   "id"
  ],
  "columns": [
   {
    "key": "name",
    "label": "Name",
    "value": "{label:name}",
    "main": true
   },
   {
    "key": "id",
    "label": "Id",
    "value": "{label:id}"
   },
   {
    "key": "node",
    "label": "Node",
    "value": "{label:node}"
   },
   {
    "key": "type",
    "label": "Type",
    "value": "{label:type}",
    "map": {
     "qemu": "VM",
     "lxc": "Container"
    }
   },
   {
    "key": "state",
    "label": "State",
    "type": "status",
    "value": {
     "query": "pve_up{id=~\"qemu/.*|lxc/.*\"}"
    },
    "map": {
