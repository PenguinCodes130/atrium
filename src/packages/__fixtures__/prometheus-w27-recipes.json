     "query": "100 * pve_memory_usage_bytes{id=~\"node/.*\"} / pve_memory_size_bytes{id=~\"node/.*\"}"
    },
    "main": true
   },
   {
    "key": "uptime",
    "label": "Uptime",
    "format": "seconds",
    "value": {
     "query": "pve_uptime_seconds{id=~\"node/.*\"}"
    },
    "main": true
   }
  ],
  "sort": {
   "by": "name"
  }
 },
 {
