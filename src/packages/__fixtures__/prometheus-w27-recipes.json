  "needs": {
   "anyMetric": [
    "node_uname_info"
   ],
   "text": "node-exporter on your machines"
  },
  "refresh": [
   60,
   30
  ],
  "params": {
   "type": "object",
   "properties": {
    "machine": {
     "type": "string",
     "title": "Machine",
     "description": "Pick one of your machines, or every machine.",
