[
 {
  "id": "machine-cpu",
  "label": "CPU in use",
  "description": "How busy one machine's processors are, in percent.",
  "group": "Machines",
  "needs": {
   "anyMetric": [
    "node_uname_info"
   ],
   "text": "node-exporter on your machines"
  },
  "refresh": [
   30,
   15
  ],
  "params": {
   "type": "object",
   "properties": {
    "machine": {
     "type": "string",
     "title": "Machine",
     "description": "Pick one of your machines, or every machine.",
     "x-atrium-choices": {
      "endpointId": "machines",
      "value": "instance",
      "label": "name",
      "detail": "detail",
      "every": true
     }
    }
   },
   "required": [
    "machine"
   ]
  },
  "measure": {
   "fixed": "cpu"
  },
  "kind": "stat",
  "query": "{{measure}}",
  "format": "measure",
  "statLabel": "CPU in use",
  "every": {
   "param": "machine",
   "key": "instance",
   "name": "{machine}"
  }
 },
