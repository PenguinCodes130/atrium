 {
  "id": "machine-summary",
  "label": "Everything about a machine",
  "description": "One row with CPU, memory, disk, network, load, uptime and temperature of one machine (or every machine).",
  "group": "Machines",
  "needs": {
   "anyMetric": [
    "node_uname_info"
   ],
   "text": "node-exporter on your machines"
  },
  "refresh": [
   30,
   15
  ],
  "params": {
   "type": "object",
   "properties": {
    "machine": {
     "type": "string",
     "title": "Machine",
     "description": "Pick one of your machines, or every machine.",
     "x-atrium-choices": {
      "endpointId": "machines",
      "value": "instance",
      "label": "name",
      "detail": "detail",
      "every": true
     }
    }
   },
   "required": [
    "machine"
   ]
  },
  "kind": "table",
  "rows": "last_over_time(node_uname_info{ {{machine}} }[1d])",
  "key": [
   "instance"
  ],
  "columns": [
   {
    "key": "name",
    "label": "Name",
    "value": "{machine}",
    "main": true
   },
   {
    "key": "instance",
    "label": "Address",
    "value": "{label:instance}"
   },
   {
    "key": "up",
    "label": "Up",
    "type": "status",
    "value": {
     "query": "up{ {{machine}} }"
    },
    "map": {
     "1": "up",
     "0": "down",
     "": "unknown"
    },
    "main": true
   },
   {
    "key": "cpu",
    "label": "CPU",
    "format": "percent",
    "value": {
     "query": "{{measure:cpu}}"
    },
    "main": true
   },
   {
    "key": "memory",
    "label": "Memory",
    "format": "percent",
    "value": {
     "query": "{{measure:memory}}"
    },
    "main": true
   },
   {
    "key": "disk",
    "label": "Disk (/)",
    "format": "percent",
    "value": {
     "query": "{{measure:disk}}"
    },
    "main": true
   },
   {
    "key": "netIn",
    "label": "Network in",
    "format": "bytesPerSec",
    "value": {
     "query": "{{measure:netIn}}"
    },
    "main": true
   },
   {
    "key": "netOut",
    "label": "Network out",
    "format": "bytesPerSec",
    "value": {
     "query": "{{measure:netOut}}"
    },
    "main": true
   },
   {
    "key": "load",
    "label": "Load (5 min)",
    "format": "number",
    "value": {
     "query": "{{measure:load5}}"
    }
   },
   {
    "key": "uptime",
    "label": "Uptime",
    "format": "seconds",
    "value": {
     "query": "{{measure:uptime}}"
    },
    "main": true
   },
   {
    "key": "temperature",
    "label": "Temperature",
    "format": "celsius",
    "value": {
     "query": "{{measure:temperature}}"
    }
   },
   {
    "key": "updates",
    "label": "Pending updates",
    "format": "number",
    "value": {
     "query": "{{measure:updates}}"
    }
   },
   {
    "key": "reboot",
    "label": "Reboot needed",
    "value": {
     "query": "{{measure:reboot}}"
    },
    "map": {
     "1": "Yes",
     "0": "No",
     "": ""
    }
   }
  ],
  "sort": {
   "by": "name"
  }
 },
 {
  "id": "machine-disks",
  "label": "Every disk of a machine",
  "description": "Each mounted disk of one machine with its size, used and free space.",
  "group": "Machines",
  "needs": {
   "anyMetric": [
    "node_uname_info"
   ],
   "text": "node-exporter on your machines"
  },
  "refresh": [
   60,
   30
  ],
  "params": {
   "type": "object",
   "properties": {
    "machine": {
     "type": "string",
     "title": "Machine",
     "description": "Pick one of your machines, or every machine.",
     "x-atrium-choices": {
      "endpointId": "machines",
      "value": "instance",
      "label": "name",
      "detail": "detail",
      "every": true
     }
    }
   },
   "required": [
    "machine"
   ]
  },
  "kind": "table",
  "rows": "node_filesystem_size_bytes{ {{machine}} {{FS}} }",
  "key": [
   "instance",
   "mountpoint"
  ],
  "columns": [
   {
    "key": "machine",
    "label": "Machine",
    "value": "{machine}",
    "main": true
   },
   {
    "key": "mount",
    "label": "Mount",
    "value": "{label:mountpoint}",
    "main": true
   },
   {
    "key": "device",
    "label": "Device",
    "value": "{label:device}"
   },
   {
    "key": "size",
    "label": "Size",
    "format": "bytes",
    "value": {
     "query": "node_filesystem_size_bytes{ {{machine}} {{FS}} }"
    },
    "main": true
   },
   {
    "key": "used",
    "label": "Used",
    "format": "bytes",
    "value": {
     "query": "node_filesystem_size_bytes{ {{machine}} {{FS}} } - node_filesystem_avail_bytes{ {{machine}} {{FS}} }"
    }
   },
   {
    "key": "free",
    "label": "Free",
    "format": "bytes",
    "value": {
     "query": "node_filesystem_avail_bytes{ {{machine}} {{FS}} }"
    }
   },
   {
    "key": "usedPct",
    "label": "Used %",
    "format": "percent",
    "value": {
     "query": "100 * (1 - node_filesystem_avail_bytes{ {{machine}} {{FS}} } / node_filesystem_size_bytes{ {{machine}} {{FS}} })"
    },
    "main": true
   }
  ],
  "sort": {
   "by": "usedPct",
   "desc": true
  }
 },
 {
  "id": "machine-history",
  "label": "Over time",
  "description": "One measure of one machine (or every machine) as a chart over the last hours.",
