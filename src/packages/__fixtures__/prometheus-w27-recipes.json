 {
  "id": "containers",
  "label": "Containers",
  "description": "Every container cAdvisor sees, with its image, CPU, memory and how long it has run.",
  "group": "Containers",
  "needs": {
   "anyMetric": [
    "container_last_seen"
   ],
   "text": "cAdvisor (container metrics)"
  },
  "refresh": [
   30,
   15
  ],
  "kind": "table",
  "rows": "max by (name, image, host, instance) (container_last_seen{name!=\"\"})",
  "key": [
   "name"
  ],
  "columns": [
   {
    "key": "name",
    "label": "Name",
    "value": "{label:name}",
    "main": true
   },
   {
    "key": "image",
    "label": "Image",
    "value": "{label:image}"
   },
   {
    "key": "host",
    "label": "Host",
    "value": "{label:host}"
   },
   {
    "key": "state",
    "label": "State",
    "type": "status",
    "value": {
     "query": "max by (name) (time() - container_last_seen{name!=\"\"} < bool 60)"
    },
    "map": {
     "1": "up",
     "0": "down",
     "": "unknown"
    },
    "main": true
   },
   {
    "key": "cpu",
    "label": "CPU",
    "format": "percent",
    "value": {
     "query": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100"
    },
    "main": true
   },
   {
    "key": "memory",
    "label": "Memory",
    "format": "bytes",
    "value": {
     "query": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})"
    },
    "main": true
   },
   {
    "key": "running",
    "label": "Running for",
    "format": "seconds",
    "value": {
     "query": "max by (name) (time() - container_start_time_seconds{name!=\"\"})"
    }
   },
   {
    "key": "detail",
    "label": "Detail",
    "value": "{label:image} · {label:host}"
   }
  ],
  "sort": {
   "by": "name"
  }
 },
