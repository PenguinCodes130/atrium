 {
  "id": "machines-disks",
  "label": "Every disk on every machine",
  "description": "Each mounted disk of every machine, the fullest first.",
  "group": "All machines",
  "needs": {
   "anyMetric": [
    "node_uname_info"
   ],
   "text": "node-exporter on your machines"
  },
  "refresh": [
   60,
   30
  ],
  "kind": "table",
  "rows": "node_filesystem_size_bytes{ {{FS}} }",
  "key": [
   "instance",
   "mountpoint"
  ],
  "columns": [
   {
    "key": "machine",
    "label": "Machine",
    "value": "{machine}",
    "main": true
   },
   {
    "key": "mount",
    "label": "Mount",
    "value": "{label:mountpoint}",
    "main": true
   },
   {
    "key": "device",
    "label": "Device",
    "value": "{label:device}"
   },
   {
    "key": "size",
    "label": "Size",
    "format": "bytes",
    "value": {
     "query": "node_filesystem_size_bytes{ {{machine}} {{FS}} }"
    },
    "main": true
   },
   {
    "key": "used",
    "label": "Used",
    "format": "bytes",
    "value": {
     "query": "node_filesystem_size_bytes{ {{machine}} {{FS}} } - node_filesystem_avail_bytes{ {{machine}} {{FS}} }"
    }
   },
   {
    "key": "free",
    "label": "Free",
    "format": "bytes",
    "value": {
     "query": "node_filesystem_avail_bytes{ {{machine}} {{FS}} }"
    }
   },
   {
    "key": "usedPct",
    "label": "Used %",
    "format": "percent",
    "value": {
     "query": "100 * (1 - node_filesystem_avail_bytes{ {{machine}} {{FS}} } / node_filesystem_size_bytes{ {{machine}} {{FS}} })"
    },
    "main": true
   }
  ],
  "sort": {
   "by": "usedPct",
   "desc": true
  }
 },
