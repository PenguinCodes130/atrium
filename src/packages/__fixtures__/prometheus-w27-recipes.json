    }
   },
   {
    "key": "disk",
    "label": "Disk used",
    "format": "bytes",
    "value": {
     "query": "pve_disk_usage_bytes{id=~\"qemu/.*|lxc/.*\"}"
    }
   },
   {
    "key": "uptime",
    "label": "Uptime",
    "format": "seconds",
    "value": {
     "query": "pve_uptime_seconds{id=~\"qemu/.*|lxc/.*\"}"
    },
    "main": true
   },
   {
    "key": "backedUp",
    "label": "Backed up",
