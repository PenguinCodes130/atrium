 },
 {
  "id": "pve-guests-history",
  "label": "Guests over time",
  "description": "CPU or memory of every Proxmox VM and container as a chart, one line per guest.",
  "group": "Proxmox",
  "needs": {
   "anyMetric": [
    "pve_up"
   ],
   "text": "the Proxmox exporter (prometheus-pve-exporter)"
  },
  "refresh": [
   60,
   30
  ],
  "params": {
   "type": "object",
   "properties": {
    "measure": {
     "type": "string",
     "title": "Measure",
     "enum": [
      "cpu",
      "memory"
     ],
     "x-atrium-labels": {
      "cpu": "CPU",
      "memory": "Memory"
     },
     "default": "cpu"
    },
    "hours": {
     "type": "number",
     "title": "Hours to show",
     "minimum": 1,
     "maximum": 720,
     "default": 6
    }
   }
  },
  "kind": "series",
  "query": {
   "param": "measure",
   "cases": {
    "cpu": "pve_cpu_usage_ratio * 100 * on(id) group_left(name) pve_guest_info",
    "memory": "100 * pve_memory_usage_bytes / pve_memory_size_bytes * on(id) group_left(name) pve_guest_info"
   }
  },
  "format": "percent",
  "name": "{label:name}"
 }
]